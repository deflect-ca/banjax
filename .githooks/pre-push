# Secret scan of every commit this push introduces to the remote, so a secret
# that was added and then removed in a later commit is still caught.
# git passes: $1 = remote name, $2 = remote url; stdin lines:
#   <local ref> <local sha> <remote ref> <remote sha>
# Activate with: scripts/dev hooks

remote="$1"
url="$2"
ROOT="$(git rev-parse --show-toplevel)" || exit 1
ZERO="0000000000000000000000000000000000000000"

echo "pre-push: scanning commits new to remote '$remote'"
case "$url" in
*deflect-ca/*) echo "pre-push: note: this remote is a public repository; everything pushed is world-readable." ;;
esac

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    # deleting a remote branch pushes no content
    case "$local_sha" in "$ZERO" | "") continue ;; esac
    if [ "$remote_sha" = "$ZERO" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        # new branch (or a remote tip we have not fetched): only the commits no
        # ref of this remote already has
        "$ROOT/scripts/secret-scan.sh" --range "$local_sha" --not "--remotes=$remote" || status=1
    else
        "$ROOT/scripts/secret-scan.sh" --range "$remote_sha..$local_sha" || status=1
    fi
done

if [ "$status" -ne 0 ]; then
    echo "pre-push: blocked. Rewrite the offending commit(s) before pushing; do not bypass this hook." >&2
fi
exit "$status"
